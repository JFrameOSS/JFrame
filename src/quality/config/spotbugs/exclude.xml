<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- http://spotbugs.readthedocs.io/en/latest/filter.html -->
<FindBugsFilter>

    <!-- Do not alarm groovy -->
    <Match>
        <Source name="~.*\.groovy"/>
    </Match>

    <!-- Disable alarm -->
    <Match>
        <!-- The reason for disable is guava, which use @Nullable for function and if you want not nullable function
         you will have to use @NotNull annotation, which contradict with original contract
         (actually not, because guava intend weaker semantics). So disable this alarm to be able to properly
         use nullability annotations -->
        <Bug pattern="NP_METHOD_PARAMETER_TIGHTENS_ANNOTATION" />
    </Match>
    <Match>
        <!-- Disabled as confusing alarm (very misleading description) and also not so useful -->
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
    <Match>
        <!-- Disabled as confusing alarm (very misleading description) and also not so useful -->
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
    <Match>
        <!-- Disabled due to confusing false positives -->
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>
    <!-- Exception hierarchy and value-object constructors intentionally throw from constructors -->
    <Match>
        <Package name="~io\.github\.jframe\.exception.*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Package name="~io\.github\.jframe\.logging\.ecs.*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Package name="~io\.github\.jframe\.logging\.masker.*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Package name="~io\.github\.jframe\.util\.converter.*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Package name="~io\.github\.jframe\.validation.*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- ResettableHttpServletRequest cap-aware constructor throws IOException when reading the request body -->
    <Match>
        <Package name="~io\.github\.jframe\.logging\.wrapper.*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

</FindBugsFilter>
